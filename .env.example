# Copy to .env; use absolute NAS paths and an existing user's numeric UID/GID.
NAS_UID=1000
NAS_GID=1000
DOWNLOAD_PATH=./downloads
STATE_PATH=./state
VERIFY_DAYS=7
PROGRESS_INTERVAL=60
MANIFEST_URL=https://raw.githubusercontent.com/KakkoiiSaber/ZenlessZoneZero_Official_Resources_Downloader/main/metafiles/wiki.json
# Optional local media Wiki port (compose.wiki.yaml).
WIKI_PORT=8080
# Show resource/download counts in the Wiki only when troubleshooting.
WIKI_DEBUG=false
